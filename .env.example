# Supabase — used for contact form submissions and lead routing.
# The /contact form inserts into a `leads` table with columns:
#   name text, email text, interest text, message text, created_at timestamptz default now()
# The anon role needs an RLS policy allowing INSERT on that table (no SELECT/UPDATE/DELETE needed).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
